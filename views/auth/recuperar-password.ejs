<div class="password-recovery-container">
    <h1>Recuperar Contraseña</h1>
    <form action="/auth/solicitar-recuperacion" method="POST" class="password-recovery-form">
        <div class="form-field">
            <span class="form-label">Email:</span>
            <input type="email" class="form-input" name="email" required>
        </div>
        <div class="help-text">Te enviaremos una contraseña temporal a tu email</div>
        <button type="submit" class="submit-button">Enviar Contraseña Temporal</button>
    </form>
    
    <div class="back-link">
        <a href="/auth/login">← Volver al Login</a>
    </div>
</div>