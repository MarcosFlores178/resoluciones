<div class="datos-usuario">
  <h1><%= titulo %></h1>

  <form action="<%= actionUrl %>" method="POST" class="grid-datos">
    <% if (modo === 'cambio') { %>
      <!-- MODO CAMBIO NORMAL (contraseña actual) -->
      <p>
        <label class="label" for="actual">Contraseña actual:</label>
        <input class="value" type="password" id="actual" name="actual" required>
      </p>
    <% } %>
    
    <% if (modo === 'olvido') { %>
      <!-- MODO OLVIDO (código temporal) -->
      <!-- <p>
        <label class="label" for="codigoTemporal">Contraseña temporal:</label>
        <input class="value" type="text" id="codigoTemporal" name="codigoTemporal" required>
      </p> -->
      <input type="hidden" name="email" value="<%= email %>">
      <input type="hidden" name="token" value="<%= token %>"> <!-- ← NUEVO -->
    <% } %>

    <p>
      <label class="label" for="nueva">Nueva contraseña:</label>
      <input class="value" type="password" id="nueva" name="nueva" required>
    </p>

    <p>
      <label class="label" for="confirmar">Confirmar nueva:</label>
      <input class="value" type="password" id="confirmar" name="confirmar" required>
    </p>

    <div style="grid-column: span 2; text-align: center; margin-top: 1.5rem;">
      <button type="submit" class="button"><%= textoBoton %></button>
      <a href="<%= urlCancelar %>" class="button" style="background-color: gray;">Cancelar</a>
    </div>
  </form>
</div>