<div class="datos-usuario">
  <h1>Registro de Usuario</h1>

  <form action="/auth/register" id="registerForm" method="POST">
    <div class="grid-datos">
      
      <p>
        <span class="label"><label for="nombre">Nombre:</label></span>
        <input type="text" id="nombre" name="nombre" class="value" required>
      </p>

      <p>
        <span class="label"><label for="apellido">Apellido:</label></span>
        <input type="text" id="apellido" name="apellido" class="value" required>
      </p>

      <p>
        <span class="label"><label for="titulo">Título:</label></span>
        <input type="text" id="titulo" name="titulo" class="value" required>
      </p>

      <p>
        <span class="label">Sexo:</span>
        <span class="value">
          <label style="margin-right: 10px;">
            <input type="radio" name="sexo_organizador" id="sexo_organizador_masculino" value="masculino"
              <%= usuario?.rol === "administrativo" ? "disabled" : "" %> required>
            Hombre
          </label>
          <label>
            <input type="radio" name="sexo_organizador" id="sexo_organizador_femenino" value="femenino"
              <%= usuario?.rol === "administrativo" ? "disabled" : "" %> required>
            Mujer
          </label>
        </span>
      </p>

      <p>
        <span class="label"><label for="telefono">Teléfono:</label></span>
        <input type="tel" id="telefono" name="telefono" class="value" required>
      </p>
    </div>
    <div class="password-container">
      <div class="password">
          <p>
            <span class="label"><label for="password">Contraseña:</label></span>
            <input type="password" id="password" name="password" class="value" required>
          </p>
    
          <p>
            <span class="label"><label for="confirm_password">Confirmar contraseña:</label></span>
            <input type="password" id="confirm_password" name="confirm_password" class="value" required>
          </p>
          </div>
    </div>

<div style="grid-column: span 2; text-align: center; margin-top: 1.5rem;">
    <button type="submit" class="button">Registrarse</button>
    </div>

  </form>
</div>
