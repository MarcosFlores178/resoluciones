
<main>
  <h1>Registro de usuario</h1>
  <form action="/auth/register" id="registerForm" method="POST" class="formulario">
    <div class="form-grid">
      <div class="form-group">
        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre" required>
    </div>
    
    <div class="form-group">
      <label for="apellido">Apellido:</label>
      <input type="text" id="apellido" name="apellido" required>
    </div>
    
    <div class="form-group">
      <label for="titulo">Título:</label>
      <input type="text" id="titulo" name="titulo" required>
    </div>

   <div class="radio-group">
      <label class="radio-option">
        <input type="radio" name="sexo_organizador" id="sexo_organizador_masculino" value="masculino" <%= usuario.rol === "administrativo" ? "disabled" : "" %> required>
        Hombre
      </label>

      <label class="radio-option">
        <input type="radio" name="sexo_organizador" id="sexo_organizador_femenino" value="femenino" <%= usuario.rol === "administrativo" ? "disabled" : "" %> required>
        Mujer
      </label>
    </div>

    <div class="form-group">
      <label for="telefono">Teléfono:</label>
      <input type="tel" id="telefono" name="telefono" required>
    </div>

     <div class="form-group">
      <label for="password">Nueva contraseña:</label>
      <input type="password" id="password" name="password" required>
    </div>
    
    <div class="form-group">
      <label for="confirm_password">Confirmar nueva contraseña:</label>
      <input type="password" id="confirm_password" name="confirm_password" required>
    </div>

    <div class="form-group full-width">
      <button type="submit">Registrarse</button>
    </div>
  </div>
</form>


</main>
