
    <div class="container">
        <h1>Ingresar Código Temporal</h1>
        
        <div class="email-info">
            📧 Código enviado a: <strong><%= email %></strong>
        </div>
        
        <!-- <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
            <div style="background: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 1rem;">
                <%= error_msg %>
            </div>
        <% } %> -->
        
        <form action="/auth/verificar-codigo" method="POST">
            <input type="hidden" name="email" value="<%= email %>">
            
            <div class="form-group">
                <label for="codigoTemporal">Contraseña Temporal</label>
                <input type="text" id="codigoTemporal" name="codigoTemporal" 
                       placeholder="Ej: A3B9X2" maxlength="6" required
                       pattern="[A-Z0-9]{6}" title="6 caracteres (letras mayúsculas y números)">
                <div class="help-text">Ingresa el código de 6 caracteres que recibiste por email</div>
            </div>
            
            <button type="submit" class="btn">Verificar Código</button>
        </form>
        
        <div class="resend-link">
            <a href="/auth/recuperar-password">¿No recibiste el código? Reenviar</a>
        </div>
        
        <div class="back-link">
            <a href="/auth/login">← Volver al Login</a>
        </div>
    </div>
