<div class="container">
<h1>Verificación</h1>
    <form action="/auth/verificar-codigo" method="POST">
        <div class="form-container">
            <div class="form-group">
                
                   <p>
                    📧 Enviado a: <strong>
                        <%= email %>
                    </strong>
                    </p>
            

                <input type="hidden" name="email" value="<%= email %>">
            </div>
            <div class="form-group">
                <label for="codigoTemporal">Ingrese el código recibido por email:</label>
                <input type="text" id="codigoTemporal" name="codigoTemporal"
                    title="6 caracteres (letras mayúsculas y números)" placeholder="ABC123">
            </div>
           
            <div class="form-group">
                <button type="submit">Verificar</button>
                
            </div>
                
                    <a href="/auth/recuperar-password">¿No lo recibiste? Reenviar</a>
                    <a href="/auth/login">← Volver</a>
                </div>
                
            
                
            </form>
        </div>

