<div class="datos-usuario">
  <h1>Cambiar Contraseña</h1>

  <form action="/usuarios/change-password" method="POST" class="grid-datos">
    <p>
      <label class="label" for="actual">Contraseña actual:</label>
      <input class="value" type="password" id="actual" name="actual" required>
    </p>

    <p>
      <label class="label" for="nueva">Nueva contraseña:</label>
      <input class="value" type="password" id="nueva" name="nueva" required>
    </p>

    <p>
      <label class="label" for="confirmar">Confirmar nueva:</label>
      <input class="value" type="password" id="confirmar" name="confirmar" required>
    </p>

    <div style="grid-column: span 2; text-align: center; margin-top: 1.5rem;">
      <button type="submit" class="button">Guardar nueva contraseña</button>
      <a href="/usuarios/profile" class="button" style="background-color: gray;">Cancelar</a>
    </div>
  </form>
</div>
