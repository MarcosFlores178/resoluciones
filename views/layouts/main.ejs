<!DOCTYPE html>
<html lang="es">
  <head>
    
   
     <%- include('../partials/head', { cssFile: typeof cssFile !== 'undefined' ? cssFile : '' }) %>

  </head>
  <body>
    <%- include('../partials/header') %>

    <main>
      <%- body %>
    </main>

    <%- include('../partials/footer') %>
  </body>

<script>
  toastr.options = {
    closeButton: true,
    progressBar: true,
    timeOut: 5000
  };
</script>

  <!-- PRIMERO el EJS fuera del script -->
<% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
  <script>
    toastr.success('<%= success_msg[0] %>');
  </script>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
  <script>
    toastr.error('<%= error_msg[0] %>');
  </script>
<% } %>

<% if (typeof warning_msg !== 'undefined' && warning_msg.length > 0) { %>
  <script>
    toastr.warning('<%= warning_msg[0] %>');
  </script>
<% } %>
  
 
</html>

