<main>
  <h1>Resoluciones guardadas</h1>
  <button class="btn-actualizar" onclick="location.reload()">🔄 Actualizar listado</button>
  <% if (usuario.rol==="organizador" ) { %>
    <table id="tabla-resoluciones">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Curso</th>
          <th>Organizador</th>
          <th>Fecha Res.</th>
          <th>N° Res.</th>
          <th>Estado</th>
          <th>fecha de estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>

        <% if (resoluciones.length===0) { %>
          <tr>
            <td colspan="6">No hay resoluciones guardadas</td>
          </tr>

          <% } else { %>
            <% resoluciones.forEach(res=> { %>
              <% if (res.id_usuarios===usuario.id_usuarios) { %>
                <tr>
                  <td>
                    <%= new Date(res.fecha_creacion).toLocaleDateString('es-AR') %>
                  </td>
                  <td>
                    <%= res.curso %>
                  </td>
                  <td>
                    <%= res.autor.nombre%>
                      <%= res.autor.apellido%>
                  </td>
                  <td>
           <%= res.fecha 
        ? (() => {
            const [anio, mes, dia] = res.fecha.split("-"); // números como strings
            return `${dia.padStart(2,'0')}/${mes.padStart(2,'0')}/${anio}`;
          })()
        : "—" 
  %>
                  </td>
                  <td>
                    <%= res.numero_resolucion || '—' %>
                  </td>
                  <td>
                    <% if (res.estado==='guardado' ) { %>
                      <span class="badge badge-warning">Guardada</span>
                      <% } else if (res.estado==='pendiente' ) { %>
                        <span class="badge badge-warning">Pendiente</span>
                        <% } else if (res.estado==='emitido' ) { %>
                          <span class="badge badge-success">Emitida</span>
                          <% } else if (res.estado==='rechazado' ) { %>
                            <span class="badge badge-success">Rechazada - Verificar</span>
                            <span class="tooltip" data-motivo="<%= res.motivo_rechazo %>">📝</span>
                            <% } else { %>
                              <span class="badge badge-secondary">Desconocido</span>
                              <% } %>
                  </td>
                  <% if (res.fecha_cambio_estado) { %>
                    <td>
                      <%= res.fecha_cambio_estado.toLocaleString('es-AR', { day: '2-digit' , month: '2-digit' ,
                        year: 'numeric' , hour: '2-digit' , minute: '2-digit' , second: '2-digit' , hour12: false }) %>
                    </td>
                    <% } else { %>
                      <td>—</td>
                      <% } %>
                        <td>

                          <% if (res.estado==='guardado' || res.estado==='modificado' || res.estado==='rechazado' ||
                            res.estado==='nuevo' ) { %>

                            <div class="btn-group">
                              <a href="/resoluciones/<%= res.id_resoluciones %>" class="btn">Editar</a>
                              <form action="/resoluciones/<%= res.id_resoluciones %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-delete"
                                  onclick="return confirm('¿Estás seguro de que deseas eliminar esta resolución?');">Eliminar</button>
                                <% } %>
                              </form>
                            </div>

                            <% if (res.estado==='emitido' ) { %>
                              <div class="reimprimir">
                                          <a href="<%= res.pdf_url %>"
                                            target="_blank" class="btn">Reimprimir</a>

                                        </div>
                              <% } %>
                        </td>
                </tr>
                <% } %>
                  <% }) %>
      </tbody>
    </table>


    <% } %>

      <% } %>


        <% if (usuario.rol==="administrativo" ) { %>
          <% if (conteoResoluciones) {
            
          
          <table id="tabla-resoluciones">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Curso</th>
                <th>Organizador</th>
                <th>Contacto</th>
                <th>Fecha Res.</th>
                <th>N° Res.</th>
                <th>Estado</th>
                <th>fecha de estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>

              <% if (resoluciones.length===0) { %>
                <tr>
                  <td colspan="6">No hay resoluciones guardadas</td>
                </tr>
                <% } else { %>
                  <% resoluciones.forEach(res=> { %>
                    <% if (res.estado==='pendiente' || res.estado==='rechazado' || res.estado==='emitido' ) { %>
                      <tr data-id="<%= res.id_resoluciones %>" data-estado="<%= res.estado %>">
                        <td>
                          <%= new Date(res.fecha_creacion).toLocaleDateString('es-AR') %>
                        </td>
                        <td>
                          <%= res.curso %>
                        </td>
                        <td>
                          <%= res.autor.nombre%>
                            <%= res.autor.apellido%>
                            
                        </td>
                        <td>
                           <a href="https://wa.me/54<%= res.autor.telefono %>" target="_blank" rel="noopener noreferrer">
                                <i class="fa-brands fa-square-whatsapp fa-lg"></i>
                              </a>
                              <a href="mailto:<%= res.autor.email %>" target="_blank" rel="noopener noreferrer">
                                <i class="fa-solid fa-envelope fa-lg"></i>
                              </a>
                        </td>
                        <td>
                                 <%= res.fecha 
        ? (() => {
            const [anio, mes, dia] = res.fecha.split("-"); // números como strings
            return `${dia.padStart(2,'0')}/${mes.padStart(2,'0')}/${anio}`;
          })()
        : "—" 
  %>
                        </td>
                        <td>
                          <%= res.numero_resolucion || '—' %>
                        </td>
                        <td class="estado">

                          <% if (res.estado==='pendiente' ) { %>
                            <span class="badge badge-warning">Pendiente</span>
                            <% } else if (res.estado==='rechazado' ) { %>
                              <span class="badge badge-success">Rechazada</span>
                              <% } else if (res.estado==='emitido' ) { %>
                                <span class="badge badge-success">Emitida</span>

                                <% } else { %>
                                  <span class="badge badge-secondary">Desconocido</span>
                                  <% } %>
                        </td>
                        <% if (res.fecha_cambio_estado) { %>
                          <td>
                            <%= res.fecha_cambio_estado.toLocaleString('es-AR', { day: '2-digit' , month: '2-digit' ,
                              year: 'numeric' , hour: '2-digit' , minute: '2-digit' , second: '2-digit' , hour12: false
                              }) %>
                          </td>
                          <% } else { %>
                            <td>—</td>
                            <% } %>
                              <td>
                                <% if (res.estado==='pendiente' ) { %>
                                  <div class="btn-group">
                                    <a href="/resoluciones/<%= res.id_resoluciones %>"
                                      class="btn btn-completar">Completar</a>
                                    <!-- <button type="button" class="btn-reject btn" data-id="<%= res.id_resoluciones %>">Rechazar</button> -->


                                    <% } %>
                                      <% if (res.estado==='emitido' ) { %>
                                        <div class="reimprimir">
                                          <a href="<%= res.pdf_url %>"
                                            target="_blank" class="btn">Reimprimir</a>

                                        </div>
                                        <% } %>
                                  </div>



                              </td>
                      </tr>
                      <% } %>
                      
                        <% }) %>
            </tbody>
          </table>

          <% } %>

            <div id="modal-rechazo" class="modal hidden">
              <div class="modal-content">
                <h3>Motivo del rechazo</h3>
                <textarea id="motivo-rechazo" rows="4" placeholder="Escriba el motivo..."></textarea>
                <div class="modal-actions">
                  <button id="btn-cancelar" class="btn btn-cancelar">Cancelar</button>
                  <button id="btn-confirmar-rechazo" class="btn btn-reject">Confirmar</button>
                </div>
              </div>
            </div>


            <% } %>
              <% } else { %>
                <p>No hay resoluciones para mostrar.</p>
                <% } %>
            // aca va el else
</main>
<script src="/js/estado.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    new DataTable('#tabla-resoluciones', {
      language: {
        url: "https://cdn.datatables.net/plug-ins/2.1.8/i18n/es-ES.json",
        },
        order: [] 
    });
  });
</script>